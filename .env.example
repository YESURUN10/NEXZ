# ========================================================
# NEXZ Environment Configuration Template
# (Do NOT place real secrets in this file or commit secrets)
# ========================================================

# --------------------------------------------------------
# Server-side Environment Variables (Vercel Serverless / Backend)
# --------------------------------------------------------
PORT=3000
NODE_ENV=production

# AI Provider Configuration ('auto' | 'gemini' | 'groq')
AI_PROVIDER=auto

# Primary AI Provider (Gemini via @google/genai)
GEMINI_API_KEY=

# Alternative AI Provider (Groq SDK)
GROQ_API_KEY=
GROQ_TOKEN_DAILY_LIMIT=100000

# Primary News API (Optional - automatically falls back to live syndicated wire)
NEWS_API_KEY=
NEWS_API_DAILY_LIMIT=90

# Firebase Admin SDK (Server-side)
FIREBASE_PROJECT_ID=nexz-c24d9
# Optional: Service account JSON string for full Firestore quota & token verification
FIREBASE_SERVICE_ACCOUNT=

# --------------------------------------------------------
# Client-side Environment Variables (Vite build / Browser)
# --------------------------------------------------------
# Optional: Leave empty or set to '/api' for same-domain Vercel deployment.
# Only set if using a separate standalone backend host (e.g. https://api.nexz.app).
VITE_API_BASE_URL=

# Firebase Client SDK Configuration
VITE_FIREBASE_API_KEY=AIzaSyAvujeJYDUcnSkNsTtTiqzHwzF0b6huC-Q
VITE_FIREBASE_AUTH_DOMAIN=nexz-c24d9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nexz-c24d9
VITE_FIREBASE_STORAGE_BUCKET=nexz-c24d9.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=192963986329
VITE_FIREBASE_APP_ID=1:192963986329:web:ab827d8f3e35267b90c908